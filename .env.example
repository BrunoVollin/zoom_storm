# ==================================================================
# Zoom Storm — root environment reference
# ==================================================================
# This file consolidates the environment variables used across every
# app in the monorepo, with values consistent with docker-compose.yml
# (host ports: Postgres on 3010, Mongo on 3020 with root/root
# credentials, Redis on 3030, Keycloak on 3040, Kafka on 3045).
#
# Each app also has its own apps/<app>/.env.example with the subset of
# variables it reads — copy the relevant block into apps/<app>/.env
# (or apps/<app>/.env.local for the web app) when setting up locally.
# ==================================================================

# ------------------------------------------------------------------
# cart-service (apps/cart-service) — port 3000
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:root@localhost:3010/zoom?schema=public"

CART_SERVICE_PORT=3000

CART_SERVICE_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
CART_SERVICE_MONGO_DB_NAME=zoom-cart

CART_SERVICE_KAFKA_CLIENT_ID=cart-service
CART_SERVICE_KAFKA_BROKERS=localhost:3045

# Set to "true" to bypass JWT authentication (local development only)
CART_SERVICE_SKIP_AUTH=false

# City used as the order's origin once it moves to IN_TRANSIT — there's no
# warehouse/distribution-center concept in the system, so this is a fixed
# configurable value.
ORDER_ORIGIN_CITY=São Paulo

# OrderDeliverySimulatorWorker: minutes a paid order spends in each simulated
# transit step (PAID -> IN_TRANSIT -> OUT_FOR_DELIVERY -> DELIVERED), and how
# often (ms) the worker polls for orders due to advance.
ORDER_TRANSIT_STEP_MINUTES=2
ORDER_SIMULATOR_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------
# products-service (apps/products-service) — port 3001
# ------------------------------------------------------------------
PRODUCTS_SERVICE_PORT=3001

PRODUCTS_SERVICE_DATABASE_URL="postgresql://postgres:root@localhost:3010/zoom?schema=public"

PRODUCTS_SERVICE_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
PRODUCTS_SERVICE_MONGO_DB_NAME=zoom-products

PRODUCTS_SERVICE_KAFKA_CLIENT_ID=products-service
PRODUCTS_SERVICE_KAFKA_BROKERS=localhost:3045

# Set to "true" to bypass admin authentication (local development only)
PRODUCTS_SERVICE_SKIP_AUTH=false

# ------------------------------------------------------------------
# notifications-service (apps/notifications-service) — port 3002
# Consumes order-events from Kafka, persists notifications, publishes to
# Redis for the BFF's WebSocket gateway to fan out in real time.
# ------------------------------------------------------------------
NOTIFICATIONS_SERVICE_PORT=3002

NOTIFICATIONS_SERVICE_DATABASE_URL="postgresql://postgres:root@localhost:3010/zoom?schema=public"

NOTIFICATIONS_SERVICE_KAFKA_CLIENT_ID=notifications-service
NOTIFICATIONS_SERVICE_KAFKA_BROKERS=localhost:3045
NOTIFICATIONS_SERVICE_KAFKA_GROUP_ID=notifications-service-worker
NOTIFICATIONS_SERVICE_KAFKA_TOPICS=order-events

# Set to "true" to bypass JWT authentication (local development only)
NOTIFICATIONS_SERVICE_SKIP_AUTH=false

# ------------------------------------------------------------------
# Keycloak (shared by products-service, bff and any other service
# that validates JWTs)
# ------------------------------------------------------------------
KEYCLOAK_ISSUER_URL=http://localhost:3040/realms/zoom-storm
KEYCLOAK_JWKS_URI=http://localhost:3040/realms/zoom-storm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=bff
KEYCLOAK_CLIENT_SECRET=hjOm3lu18570zFI86ZyJ5uDP6dieUaL5

# Optional. Export both values before running setup-keycloak.sh to configure
# the Google identity provider. When omitted, /auth/google falls back to the
# regular Keycloak login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# api-gateway (apps/api-gateway) — port 8087
# ------------------------------------------------------------------
API_GATEWAY_PORT=8087

CART_SERVICE_URL=http://localhost:3000
PRODUCTS_SERVICE_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-shared-secret
NOTIFICATIONS_SERVICE_URL=http://localhost:3002

# ------------------------------------------------------------------
# bff (apps/bff) — port 8088
# WebSocket notifications endpoint at /ws — browser connects to it directly
# (Next.js route handlers can't proxy an Upgrade: websocket handshake).
# ------------------------------------------------------------------
BFF_PORT=8088
BFF_BASE_URL=http://localhost:8088

GATEWAY_URL=http://localhost:8087

REDIS_URL=redis://localhost:3030

COOKIE_SECRET=change-me
SESSION_COOKIE_NAME=__Host-session
FRONTEND_URL=http://localhost:3100

# ------------------------------------------------------------------
# cart-projection (apps/cart-projection)
# ------------------------------------------------------------------
CART_PROJECTION_KAFKA_CLIENT_ID=cart-projection
CART_PROJECTION_KAFKA_BROKERS=localhost:3045
CART_PROJECTION_KAFKA_GROUP_ID=cart-projection-worker
CART_PROJECTION_KAFKA_TOPICS=cart-events,checkout-events,order-events

CART_PROJECTION_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
CART_PROJECTION_MONGO_DB_NAME=zoom-cart

# ------------------------------------------------------------------
# products-projection (apps/products-projection)
# ------------------------------------------------------------------
PRODUCTS_PROJECTION_KAFKA_CLIENT_ID=products-projection
PRODUCTS_PROJECTION_KAFKA_BROKERS=localhost:3045
PRODUCTS_PROJECTION_KAFKA_GROUP_ID=products-projection-worker
PRODUCTS_PROJECTION_KAFKA_TOPICS=product-events

PRODUCTS_PROJECTION_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
PRODUCTS_PROJECTION_MONGO_DB_NAME=zoom-products

# ------------------------------------------------------------------
# cart-products-projection (apps/cart-products-projection)
# ------------------------------------------------------------------
CART_PRODUCTS_PROJECTION_KAFKA_CLIENT_ID=cart-products-projection
CART_PRODUCTS_PROJECTION_KAFKA_BROKERS=localhost:3045
CART_PRODUCTS_PROJECTION_KAFKA_GROUP_ID=cart-products-projection-worker
CART_PRODUCTS_PROJECTION_KAFKA_TOPICS=product-events

CART_PRODUCTS_PROJECTION_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
CART_PRODUCTS_PROJECTION_MONGO_DB_NAME=zoom-cart

# ------------------------------------------------------------------
# Observability — OpenTelemetry Collector (local), shared by every
# backend service and by apps/web. See docker-compose.yml for the
# otel-collector/tempo/loki/prometheus/grafana stack (Grafana on
# http://localhost:3080).
# ------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ------------------------------------------------------------------
# web (apps/web) — Next.js storefront, port 3100
# Use apps/web/.env.local (not the root .env)
# ------------------------------------------------------------------
BFF_BASE_URL=http://localhost:8088
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_BFF_WS_URL=ws://localhost:8088/ws
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
