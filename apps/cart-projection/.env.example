# ==================================================
# Cart Projection Worker
# ==================================================

# Kafka
CART_PROJECTION_KAFKA_CLIENT_ID=zoom-app
CART_PROJECTION_KAFKA_BROKERS=localhost:3045
CART_PROJECTION_KAFKA_GROUP_ID=cart-projection-worker
CART_PROJECTION_KAFKA_TOPICS=cart-events,checkout-events,order-events

# MongoDB
CART_PROJECTION_MONGO_URI=mongodb://root:root@localhost:3020/?authSource=admin
CART_PROJECTION_MONGO_DB_NAME=zoom-cart

# OpenTelemetry Collector (local) — traces/metrics/logs are exported here
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318