// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String @id
  name            String
  description     String
  category        String
  transportHeight Int
  transportWidth  Int
  transportLength Int
  weight          Float  @default(0)

  brand                String?
  tags                 String[]
  images               String[]
  thumbnail            String?
  discountPercentage   Float?
  rating               Float?
  width                Float?
  height               Float?
  depth                Float?
  warrantyInformation  String?
  shippingInformation  String?
  availabilityStatus   String?
  returnPolicy         String?
  minimumOrderQuantity Int       @default(1)
  barcode              String?
  qrCode               String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  variants            ProductVariant[]
  reviews             ProductReview[]
  reviewEligibilities ReviewEligibility[]
}

model ProductVariant {
  id            String  @id
  product       Product @relation(fields: [productId], references: [id])
  productId     String
  sku           String  @unique
  name          String?
  price         Float
  stock         Int
  reservedStock Int     @default(0)
  isDefault     Boolean @default(false)

  reservationLines InventoryReservationLine[]

  @@index([productId])
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model InventoryReservation {
  id        String                     @id
  orderId   String                     @unique
  status    InventoryReservationStatus
  createdAt DateTime
  expiresAt DateTime
  updatedAt DateTime

  lines InventoryReservationLine[]

  @@index([status, expiresAt])
}

model InventoryReservationLine {
  id            String               @id @default(uuid())
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  variant       ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId     String
  quantity      Int
  expectedUnitPrice Float

  @@unique([reservationId, variantId])
  @@index([variantId])
}

model ProductReview {
  id            String   @id
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  rating        Int
  comment       String
  reviewerName  String
  reviewerEmail String
  createdAt     DateTime @default(now())
  userId        String?
  orderId       String?

  @@unique([userId, orderId, productId])
  @@index([productId])
}

model ReviewEligibility {
  id          String   @id
  userId      String
  orderId     String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   String
  deliveredAt DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, orderId, productId])
  @@index([productId])
}

model FlashOffer {
  id          String   @id
  productId   String
  title       String
  discountPct Float
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  occurredAt  DateTime
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
