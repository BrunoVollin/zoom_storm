// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String @id
  name            String
  price           Float
  description     String
  category        String
  stock           Int
  transportHeight Int
  transportWidth  Int
  transportLength Int
  weight          Float  @default(0)
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  occurredAt  DateTime
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
