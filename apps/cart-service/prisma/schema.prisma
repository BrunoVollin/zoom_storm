// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id        String       @id
  name      String
  start     DateTime
  end       DateTime
  type      CouponType   @default(PERCENT)
  percent   Float?
  amount    Float?
  version   Int          @default(1)
  deletedAt DateTime?
  carts     CartCoupon[]
}

model Cart {
  id      String       @id
  userId  String
  version Int          @default(0)
  items   CartItem[]
  coupons CartCoupon[]
}

model CartItem {
  id                 String  @id
  cart               Cart    @relation(fields: [cartId], references: [id])
  cartId             String
  productId          String
  productName        String
  productDescription String
  productCategory    String
  variantId          String?
  variantSku         String?
  variantName        String?
  variantPrice       Float
  variantStock       Int
  productWeight      Float
  transportHeight    Int
  transportWidth     Int
  transportLength    Int
  quantity           Int

  @@index([cartId])
}

model CartCoupon {
  cart           Cart   @relation(fields: [cartId], references: [id])
  cartId         String
  coupon         Coupon @relation(fields: [couponId], references: [id])
  couponId       String
  appliedVersion Int    @default(1)

  @@id([cartId, couponId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  occurredAt  DateTime
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

enum OrderStatus {
  CREATED
  PAID
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  EXPIRED
}

model Order {
  id              String           @id
  userId          String
  cartId          String
  subtotal        Float
  discount        Float
  shipping        Float
  total           Float
  status          OrderStatus      @default(CREATED)
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  expiresAt       DateTime
  originCity      String?
  destinationCity String?
  checkoutIdempotencyKey String
  inventoryReservationId String
  savedAddressId    String
  shippingAddress  Json

  @@index([userId])
  @@unique([userId, checkoutIdempotencyKey])
  @@index([status, expiresAt])
}

model OrderItem {
  id           String @id
  order        Order  @relation(fields: [orderId], references: [id])
  orderId      String
  productId    String
  variantId    String
  productName  String
  productPrice Float
  quantity     Int

  @@index([orderId])
}

model WishlistItem {
  id          String   @id
  userId      String
  productId   String
  productName String
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

model LoyaltyAccount {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model LoyaltyTransaction {
  id        String                 @id
  userId    String
  orderId   String?
  type      LoyaltyTransactionType
  points    Int
  createdAt DateTime               @default(now())

  @@index([userId])
}

enum LoyaltyReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model LoyaltyReservation {
  orderId   String                   @id
  userId    String
  points    Int
  status    LoyaltyReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

model ShippingQuote {
  id          String   @id
  cartId      String
  addressId   String
  cartVersion Int
  shipping    Float
  estimatedDays Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([cartId])
}

model UserProfile {
  userId              String   @id
  fullName            String
  document            String
  addressStreet       String
  addressNumber       String
  addressComplement   String?
  addressNeighborhood String
  addressCity         String
  addressState        String
  addressZip          String
  updatedAt           DateTime @updatedAt
}

model SavedCard {
  id         String   @id
  userId     String
  brand      String
  lastFour   String
  holderName String
  expiry     String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model SavedAddress {
  id           String   @id
  userId       String
  label        String
  recipient    String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip          String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentMethodType {
  SAVED_CARD
  NEW_CARD
}

model PaymentAttempt {
  id             String               @id
  order          Order                @relation(fields: [orderId], references: [id])
  orderId        String
  userId         String
  idempotencyKey String
  methodType     PaymentMethodType
  savedCardId    String?
  brand          String
  lastFour       String
  holderName     String
  expiry         String
  saveCard       Boolean              @default(false)
  installments   Int
  status         PaymentAttemptStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([orderId])
}
