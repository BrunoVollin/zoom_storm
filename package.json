{
  "name": "zoom_storm",
  "version": "1.0.0",
  "description": "uma loja jogos atuais e retro ",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "dev": "concurrently --names \"gateway,cart,products,notifications,notifications-consumer,proj,products-proj,cart-products-proj,bff,web\" --prefix-colors \"blue,green,yellow,yellowBright,yellowBright,magenta,red,cyan,white,gray\" \"yarn dev:gateway\" \"yarn dev:cart\" \"yarn dev:products\" \"yarn dev:notifications\" \"yarn dev:notifications-consumer\" \"yarn dev:proj\" \"yarn dev:products-proj\" \"yarn dev:cart-products-proj\" \"yarn dev:bff\" \"yarn dev:web\"",
    "test": "jest",
    "start": "tsx index.ts",
    "format": "prettier --write \"apps/**/*.{js,ts}\"",
    "lint": "yarn format && eslint . --fix",
    "postinstall": "prisma generate",
    "dev:proj": "cd apps/cart-projection && OTEL_SERVICE_NAME=cart-projection tsx watch --inspect=0.0.0.0:9232 -r ../../otel/tracing.ts index.ts",
    "dev:products-proj": "cd apps/products-projection && OTEL_SERVICE_NAME=products-projection tsx watch --inspect=0.0.0.0:9233 -r ../../otel/tracing.ts index.ts",
    "dev:cart-products-proj": "cd apps/cart-products-projection && OTEL_SERVICE_NAME=cart-products-projection tsx watch --inspect=0.0.0.0:9234 -r ../../otel/tracing.ts index.ts",
    "dev:cart": "OTEL_SERVICE_NAME=cart-service tsx watch --inspect=0.0.0.0:9230 --tsconfig tsconfig.json -r ./otel/tracing.ts -r register-env.ts apps/cart-service/src/infrastructure/http/server.ts",
    "dev:products": "OTEL_SERVICE_NAME=products-service tsx watch --inspect=0.0.0.0:9231 --tsconfig tsconfig.json -r ./otel/tracing.ts apps/products-service/src/infrastructure/http/server.ts",
    "dev:gateway": "OTEL_SERVICE_NAME=api-gateway tsx watch --inspect=0.0.0.0:9229 --tsconfig tsconfig.json -r ./otel/tracing.ts apps/api-gateway/src/infrastructure/http/server.ts",
    "dev:bff": "OTEL_SERVICE_NAME=bff tsx watch --inspect=0.0.0.0:9235 --tsconfig tsconfig.json -r ./otel/tracing.ts apps/bff/src/infrastructure/http/server.ts",
    "dev:web": "cd apps/web && NODE_OPTIONS=\"--inspect=0.0.0.0:9236\" yarn dev",
    "dev:notifications": "OTEL_SERVICE_NAME=notifications-service tsx watch --inspect=0.0.0.0:9237 --tsconfig tsconfig.json -r ./otel/tracing.ts apps/notifications-service/src/infrastructure/http/server.ts",
    "dev:notifications-consumer": "cd apps/notifications-service && OTEL_SERVICE_NAME=notifications-service-consumer tsx watch --inspect=0.0.0.0:9238 -r ../../otel/tracing.ts index.ts",
    "e2e:infra:up": "bash scripts/e2e/up-infra.sh",
    "e2e:data:prepare": "ZOOM_STORM_E2E_MARKER=zoom-storm-e2e bash scripts/e2e/prepare-data.sh",
    "e2e:host:start": "ZOOM_STORM_E2E_MARKER=zoom-storm-e2e bash scripts/e2e/start-host.sh",
    "e2e:ready": "bash scripts/e2e/wait-ready.sh",
    "e2e:logs": "bash scripts/e2e/collect-logs.sh",
    "e2e:down": "ZOOM_STORM_E2E_MARKER=zoom-storm-e2e bash scripts/e2e/down.sh",
    "e2e:real": "bash scripts/e2e/run-real.sh",
    "sand": "tsx sandbox.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/instrumentation": "^7.9.1",
    "@types/dotenv": "^8.2.3",
    "@types/kafkajs": "^1.9.0",
    "@types/pg": "^8.20.0",
    "@types/prompts": "^2.4.9",
    "dotenv": "^17.4.2",
    "hono": "^4.12.8",
    "install": "^0.13.0",
    "ioredis": "^5.11.1",
    "jiti": "^2.7.0",
    "jose": "^6.2.2",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.2.0",
    "npm": "^11.15.0",
    "openid-client": "^6.8.4",
    "pg": "^8.21.0",
    "prompts": "^2.4.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-config-fbjs": "^4.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-comments": "^1.2.1",
    "globals": "^17.6.0",
    "hermes-eslint": "^0.36.1",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "typescript-eslint": "^8.60.0"
  }
}
